# Lo escribe «bin/pos instalar» (permisos 600). Nunca subas .env al repo.
# Nombre de la instancia: separa varias instalaciones en el mismo PC (contenedores, servicios, puertos)
POS_INSTANCE=pos
POS_TZ=Europe/Madrid
POS_PORT=8770
POS_DB_PORT=55433
# Motor Claude: token de tu suscripción (en el PC: claude setup-token). Vacío si usas otro motor.
CLAUDE_CODE_OAUTH_TOKEN=
# Opcional: bot de Telegram para copiar las alertas críticas (solo salida)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
