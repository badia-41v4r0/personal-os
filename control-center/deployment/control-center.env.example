# data/control-center/secrets.env (chmod 600, fuera de git). Lo crea «bin/pos instalar».
CC_HOSTAGENT_TOKEN=   # python3 -c 'import secrets;print(secrets.token_hex(32))'
# Orígenes desde los que se usa el panel. Con Tailscale Serve, añade https://<equipo>.<tailnet>.ts.net:<puerto>
CC_ALLOWED_ORIGINS=http://127.0.0.1:8770,http://localhost:8770
# 1 detrás de HTTPS (Tailscale Serve); 0 solo para HTTP local
CC_COOKIE_SECURE=0
# La añade pasar-a-postgres.sh. Sin ella, el panel usa SQLite (data/control-center/cc.db)
# CC_DB_URL=postgresql+psycopg://pos:clave@127.0.0.1:55433/personal_os
