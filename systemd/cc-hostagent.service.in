# Instalado en ~/.config/systemd/user/ (bin del Control Center: control-center/deployment/instalar.sh)
[Unit]
Description=@INST@ panel: Host Agent (capacidades limitadas del host)

[Service]
Environment=POS_INSTANCE=@INST@ POS_TZ=@TZ@
EnvironmentFile=@ROOT@/data/control-center/secrets.env
WorkingDirectory=@ROOT@/control-center/backend
ExecStart=@ROOT@/control-center/backend/.venv/bin/python ../host-agent/hostagent.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
UMask=0077
PrivateTmp=yes
# VirtualBox (máquinas locales): su canal IPC está en /tmp. Se comparte solo esa carpeta para hablar con el mismo
# VBoxSVC que el usuario; si no, el servicio levanta otro, ve las VMs apagadas y no puede arrancarlas.
ExecStartPre=+/usr/bin/mkdir -p -m 0700 /tmp/.vbox-%u-ipc
BindPaths=-/tmp/.vbox-%u-ipc
MemoryMax=256M
CPUQuota=25%

[Install]
WantedBy=default.target
